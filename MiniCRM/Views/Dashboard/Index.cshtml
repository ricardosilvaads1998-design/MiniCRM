@model MiniCRM.Models.DashboardViewModel

@{
ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">

<!-- Cabeçalho -->
<div class="mb-5">
<h1 class="fw-bold">Dashboard</h1>
<p class="text-muted mb-0">
Bem-vindo ao MiniCRM.
</p>
</div>

<!-- Cartões principais -->
<div class="row g-4 mb-5">

<!-- Total de Clientes -->
<div class="col-md-4">
<div class="card shadow-sm h-100">
<div class="card-body">

<h6 class="text-muted">Total de Clientes</h6>

<h2 class="fw-bold">
@Model.TotalClientes
</h2>

<p class="text-muted mb-3">
Clientes registados no sistema.
</p>

<a href="/ClientesView"
class="btn btn-primary btn-sm">
Ver Clientes
</a>

</div>
</div>
</div>

<!-- Estado -->
<div class="col-md-4">
<div class="card shadow-sm h-100">
<div class="card-body">

<h6 class="text-muted">Estado</h6>

<h2 class="fw-bold">
✓
</h2>

<p class="mb-0 text-success">
Sistema operacional
</p>

</div>
</div>
</div>

<!-- Gestão -->
<div class="col-md-4">
<div class="card shadow-sm h-100">
<div class="card-body">

<h6 class="text-muted">Gestão</h6>

<h2 class="fw-bold">
👥
</h2>

<p class="mb-3">
Gestão de clientes
</p>

<a href="/ClientesView/Create"
class="btn btn-primary btn-sm">
+ Novo Cliente
</a>

</div>
</div>
</div>

</div>

<!-- Últimos Clientes -->
<div class="card shadow-sm">

<div class="card-header bg-dark text-white">
<h5 class="mb-0">
Últimos Clientes
</h5>
</div>

<div class="card-body">

@if (Model.UltimosClientes == null ||
Model.UltimosClientes.Count == 0)
{
<div class="text-center py-4">
<p class="text-muted mb-3">
Ainda não existem clientes cadastrados.
</p>

<a href="/ClientesView/Create"
class="btn btn-primary">
+ Criar primeiro cliente
</a>
</div>
}
else
{
<div class="table-responsive">

<table class="table table-hover align-middle mb-0">

<thead>
<tr>
<th>Nome</th>
<th>Email</th>
<th>Telefone</th>
<th class="text-end">Ação</th>
</tr>
</thead>

<tbody>

@foreach (var cliente in Model.UltimosClientes)
{
<tr>

<td>
<strong>
@cliente.Nome
</strong>
</td>

<td>
@cliente.Email
</td>

<td>
@cliente.Telefone
</td>

<td class="text-end">

<a href="/ClientesView/Edit/@cliente.Id"
class="btn btn-warning btn-sm">
Editar
</a>

</td>

</tr>
}

</tbody>

</table>

</div>

<div class="mt-3">

<a href="/ClientesView"
class="btn btn-outline-primary">
Ver todos os clientes →
					</a>

				</div>
			}

		</div>

	</div>

</div>
