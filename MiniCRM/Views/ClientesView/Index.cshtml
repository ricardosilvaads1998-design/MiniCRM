@model List<MiniCRM.Models.Cliente>

@{
	ViewData["Title"] = "Clientes";
}

<div class="container mt-5">
	@if (TempData["Sucesso"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Sucesso"]

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert"
					aria-label="Fechar">
			</button>
		</div>
	}
	<form method="get" action="/ClientesView" class="mb-4">
		<div class="input-group">

			<input type="text"
				   name="pesquisa"
				   class="form-control"
				   placeholder="Pesquisar por nome ou email..."
				   value="@Context.Request.Query["pesquisa"]" />

			<button type="submit" class="btn btn-primary">
				Pesquisar
			</button>

			<a href="/ClientesView" class="btn btn-secondary">
				Limpar
			</a>

		</div>
	</form>

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="fw-bold">Clientes</h1>
			<p class="text-muted">Gerencie os clientes cadastrados no MiniCRM.</p>
		</div>

		<a href="/ClientesView/Create" class="btn btn-primary">
			+ Novo Cliente
		</a>
	</div>

	<div class="card shadow-sm">
		<div class="card-body">

			<div class="table-responsive">
				<table class="table table-hover align-middle">

					<thead class="table-dark">
						<tr>
							<th>Nome</th>
							<th>Email</th>
							<th>Telefone</th>
							<th>Ações</th>
						</tr>
					</thead>

					<tbody>
						@foreach (var cliente in Model)
						{
						<tr>
							<td>@cliente.Nome</td>
							<td>@cliente.Email</td>
							<td>@cliente.Telefone</td>

							<td>
								<a href="/ClientesView/Edit/@cliente.Id"
								   class="btn btn-warning btn-sm me-2">
								   Editar
								</a>

								<a href="/ClientesView/Delete/@cliente.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Tem a certeza que deseja apagar este cliente?');">
                                   Apagar

								</a>
							</td>
						</tr>
						}
					</tbody>
						
				</table>
				
				@if (ViewBag.TotalPaginas > 1)
				{
					<nav class="mt-4">
						<ul class="pagination justify-content-center">

							@if (ViewBag.PaginaAtual > 1)
							{
								<li class="page-item">
									<a class="page-link"
									   href="/ClientesView?pagina=@(ViewBag.PaginaAtual - 1)&pesquisa=@ViewBag.Pesquisa">
										Anterior
									</a>
								</li>
							}

							@for (int i = 1; i <= ViewBag.TotalPaginas; i++)
							{
								<li class="page-item @(i == ViewBag.PaginaAtual ? "active" : "")">
									<a class="page-link"
									   href="/ClientesView?pagina=@i&pesquisa=@ViewBag.Pesquisa">
										@i
									</a>
								</li>
							}

							@if (ViewBag.PaginaAtual < ViewBag.TotalPaginas)
							{
								<li class="page-item">
									<a class="page-link"
									   href="/ClientesView?pagina=@(ViewBag.PaginaAtual + 1)&pesquisa=@ViewBag.Pesquisa">
										Próximo
									</a>
								</li>
							}

						</ul>
					</nav>
				}
			</div>

		</div>
	</div>

</div>
						